<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".TeamPage">

    <ImageButton
        android:id="@+id/btnTeamOptions"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/more_options"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/TeamPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#F59E0B"
                android:textSize="35sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/tvTeamTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Team Time Left:"
                        android:textColor="#F59E0B"
                        android:textSize="20sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/agreedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agreed_time"
                        android:textColor="#F59E0B"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/tvTeamUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Time Used: --"
                        android:textColor="#F59E0B"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/teamProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="6dp"
                        android:indeterminate="false"
                        app:indicatorColor="#0F172A"
                        app:indicatorSize="150dp"
                        android:max="100"
                        android:progress="0"
                        app:trackColor="#14BBAB"
                        app:trackThickness="12dp" />

                    <TextView
                        android:id="@+id/tvCircleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="-- min"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#F59E0B" />
                </FrameLayout>
            </LinearLayout>

            <!-- Blocked Apps header with + and - buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingStart="20dp">

                <TextView
                    android:id="@+id/blockedApps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blocked_apps"
                    android:textColor="#F59E0B"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnAddApps"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:backgroundTint="#14BBAB"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp" />

                <Button
                    android:id="@+id/btnRemoveApps"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:backgroundTint="#FF0000"
                    android:padding="0dp"
                    android:text="-"
                    android:textSize="18sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Approved Apps list -->
            <LinearLayout
                android:id="@+id/approvedAppsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"/>

            <!-- Pending Apps title - hidden by default -->
            <TextView
                android:id="@+id/tvPendingAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Apps"
                android:textColor="#F59E0B"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <!-- Pending Apps list - hidden by default -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"/>

            <!-- Team Usage -->
            <TextView
                android:id="@+id/TeamStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Team Usage"
                android:textColor="#F59E0B"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:id="@+id/memberContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#111E2B"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3">

        <ImageView
            android:id="@+id/tvNavStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/stats_icon"/>

        <ImageView
            android:id="@+id/tvNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/home_icon"/>

        <ImageView
            android:id="@+id/tvNavBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/block_icon"/>
    </LinearLayout>
</LinearLayout>