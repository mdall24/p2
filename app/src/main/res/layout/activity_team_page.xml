<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".TeamPage">

    <TextView
        android:id="@+id/TeamPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Placeholder"
        android:textColor="#5F0303"
        android:textSize="35sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="113dp"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/TeamStats"
        android:layout_width="146dp"
        android:layout_height="39dp"
        android:text="Team Usage"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="20dp"
        tools:layout_editor_absoluteY="301dp" />

    <TextView
        android:id="@+id/tvTeamTotal"
        android:layout_width="159dp"
        android:layout_height="41dp"
        android:text="Team Time Left:"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="141dp" />

    <TextView
        android:id="@+id/tvTeamUsed"
        android:layout_width="166dp"
        android:layout_height="46dp"
        android:text="Total Used: --"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="9dp"
        tools:layout_editor_absoluteY="494dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembers"
        android:layout_width="392dp"
        android:layout_height="154dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="340dp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/teamProgress"
        android:layout_width="288dp"
        android:layout_height="156dp"
        android:layout_gravity="center"
        android:padding="6dp"
        app:indeterminate="false"
        app:indicatorColor="#0F172A"
        app:indicatorSize="150dp"
        app:max="100"
        app:progress="0"
        app:trackColor="#14BBAB"
        app:trackThickness="12dp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="194dp"
        tools:layout_editor_absoluteY="92dp" />

    <TextView
        android:id="@+id/tvCircleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- min"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/teamProgress"
        app:layout_constraintEnd_toEndOf="@+id/teamProgress"
        app:layout_constraintStart_toStartOf="@+id/teamProgress"
        app:layout_constraintTop_toTopOf="@+id/teamProgress" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="#111E2B"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNavStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Statistics"
            android:textColor="#AABBCC"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#AABBCC"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvNavBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Block"
            android:textColor="#AABBCC"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/agreedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/agreed_time"
        android:textColor="#F59E0B"
        app:layout_constraintBottom_toTopOf="@+id/TeamStats"
        app:layout_constraintEnd_toStartOf="@+id/teamProgress"
        app:layout_constraintHorizontal_bias="0.229"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTeamTotal"
        app:layout_constraintVertical_bias="0.88" />

    <TextView
        android:id="@+id/blockedApps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/blocked_apps"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="9dp"
        tools:layout_editor_absoluteY="594dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btnAddApps"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:backgroundTint="#14BBAB"
        android:padding="0dp"
        android:text="+"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.583"
        app:layout_constraintStart_toEndOf="@+id/blockedApps"
        app:layout_constraintTop_toBottomOf="@+id/tvTeamUsed"
        app:layout_constraintVertical_bias="0.414" />

    <Button
        android:id="@+id/btnRemoveApps"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:backgroundTint="#14BBAB"
        android:padding="0dp"
        android:text="-"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.323"
        app:layout_constraintStart_toEndOf="@+id/btnAddApps"
        app:layout_constraintTop_toBottomOf="@+id/tvTeamUsed"
        app:layout_constraintVertical_bias="0.414" />

</androidx.constraintlayout.widget.ConstraintLayout>