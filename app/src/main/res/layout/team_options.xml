<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E293B"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">
    
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#F59E0B"
        android:backgroundTint="#4DAABBCC"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Team Options"
        android:textColor="#F59E0B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/btnLeaveTeam"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:text="Leave Team"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/btnInviteMember"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:text="Invite a Member"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/btnKickMember"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:text="Kick a Member"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"/>

    <View
        android:id="@+id/dividerDisband"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        android:background="#2E3D50"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/btnDisbandTeam"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:text="Disband Team"
        android:textColor="#EF4444"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"/>


</LinearLayout>