<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".CreateTeam">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/AddAppButton"
        android:contentDescription="@string/desc"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.041"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/GroupDefinition"
        app:layout_constraintVertical_bias="0.218"
        app:srcCompat="@drawable/plus_sign_placeholder" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Create a Group"
        android:textColor="#F59E0B"
        android:textSize="35sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/GroupName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:hint="Group Name..."
        android:inputType="text"
        android:textColor="#F59E0B"
        android:textColorHint="#67F59E0B"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintVertical_bias="0.304" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/GroupDefinition"
        app:layout_contraintBottom_toTopOf="@+id/SendInvite"
        app:layout_contraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/SendInvite"
        android:layout_width="128dp"
        android:layout_height="48dp"
        android:layout_marginBottom="36dp"
        android:backgroundTint="#14BBAB"
        android:text="Send Invite"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/AddAppText"
        android:layout_width="203dp"
        android:layout_height="28dp"
        android:text="Add app(s) to block"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/SendInvite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.077"
        app:layout_constraintStart_toEndOf="@+id/SuggestedTimeButton"
        app:layout_constraintTop_toBottomOf="@+id/GroupDefinition"
        app:layout_constraintVertical_bias="0.272" />

    <EditText
        android:id="@+id/GroupDefinition"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="Describe Group..."
        android:inputType="text"
        android:textColor="#F59E0B"
        android:textColorHint="#67F59E0B"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/GroupName" />

    <TextView
        android:id="@+id/SuggestedTimetext"
        android:layout_width="203dp"
        android:layout_height="28dp"
        android:text="Suggest weekly group time"
        android:textColor="#F59E0B"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/SendInvite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.077"
        app:layout_constraintStart_toEndOf="@+id/SuggestedTimeButton"
        app:layout_constraintTop_toBottomOf="@+id/GroupDefinition"
        app:layout_constraintVertical_bias="0.497" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/SuggestedTimeButton"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.041"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/GroupDefinition"
        app:layout_constraintVertical_bias="0.383"
        app:srcCompat="@drawable/plus_sign_placeholder" />

</androidx.constraintlayout.widget.ConstraintLayout>