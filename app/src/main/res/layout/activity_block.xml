<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="140dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvBudgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocklist"
            android:textColor="#F4A430"
            android:textSize="36sp"
            android:textStyle="bold|italic"
            android:layout_marginBottom="4dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your blocking preferences"
            android:textColor="#AABBCC"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <!-- Toggle for Overlay Service -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_status"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- List of blocked apps -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBlockedApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnAddApps"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:text="+ Add Apps"
        android:backgroundTint="#00C8A0"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="#111E2B"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvNavStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Statistics"
            android:textColor="#AABBCC"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#AABBCC"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvNavBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Block"
            android:textColor="#00C8A0"
            android:textSize="11sp"/>

    </LinearLayout>

</FrameLayout>