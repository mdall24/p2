<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:scaleX="1"
    tools:context=".statistics">

    <TextView
        android:id="@+id/titleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Statistics"
        android:textColor="#FFB95F"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/descriptionView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="An overview of your groups statistics"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleView" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descriptionView">

        <LinearLayout
            android:id="@+id/statistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#1A2B3C"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <View android:layout_width="12dp" android:layout_height="12dp" android:background="#00C8A0" android:layout_marginEnd="4dp" android:layout_gravity="center_vertical"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your avg" android:textColor="#AABBCC" android:textSize="11sp" android:layout_marginEnd="12dp"/>
                            <View android:layout_width="12dp" android:layout_height="12dp" android:background="#F4A430" android:layout_marginEnd="4dp" android:layout_gravity="center_vertical"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Group avg" android:textColor="#AABBCC" android:textSize="11sp"/>
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChart"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="16dp"
                    android:text="Best Time Savers"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/groupLeaderboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/firstPlaceFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/groupFirstPlace"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#1A2B3C"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_launcher_foreground" />

                                <TextView
                                    android:id="@+id/tvFirstPlace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="Username Placeholder"
                                    android:textColor="#AABBCC"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/circle_gold"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:text="#1"
                            android:textColor="#1A2B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/secondPlaceFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/groupSecondPlace"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#1A2B3C"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_launcher_foreground" />

                                <TextView
                                    android:id="@+id/tvSecondPlace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="Username Placeholder"
                                    android:textColor="#AABBCC"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/circle_silver"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:text="#2"
                            android:textColor="#1A2B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/thirdPlaceFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/groupThirdPlace"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#1A2B3C"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_launcher_foreground" />

                                <TextView
                                    android:id="@+id/tvThirdPlace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="Username Placeholder"
                                    android:textColor="#AABBCC"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/circle_bronze"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:text="#3"
                            android:textColor="#1A2B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/fourthPlaceFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/groupFourthPlace"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#1A2B3C"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_launcher_foreground" />

                                <TextView
                                    android:id="@+id/tvFourthPlace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="Username Placeholder"
                                    android:textColor="#AABBCC"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/circle_grey"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:text="#4"
                            android:textColor="#1A2B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/fifthPlaceFrame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/groupFifthPlace"
                            android:layout_width="300dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="20dp"
                            app:cardBackgroundColor="#1A2B3C"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginRight="10dp"
                                android:layout_marginBottom="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_launcher_foreground" />

                                <TextView
                                    android:id="@+id/tvFifthPlace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="Username Placeholder"
                                    android:textColor="#AABBCC"
                                    android:textSize="11sp" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/circle_grey"
                            android:elevation="6dp"
                            android:gravity="center"
                            android:text="#5"
                            android:textColor="#1A2B3C"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnCreateTeam"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="15dp"
                        android:backgroundTint="#00C8A0"
                        android:text="+     Create Team"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="24sp" />

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/previousTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#1A2B3C"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="343dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btnPrevTime"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Previous Time"
                    android:textSize="16dp"
                    android:drawableStart="@drawable/rounded_button" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#111E2B"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/tvNavStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/stats_icon"/>

        <ImageView
            android:id="@+id/tvNavHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/home_icon"/>

        <ImageView
            android:id="@+id/tvNavBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_weight="1"
            android:scaleType="center"
            app:srcCompat="@drawable/block_icon"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>