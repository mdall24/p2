<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="10dp">
    
    <TextView
        android:id="@+id/appPurpose"
        android:layout_width="392dp"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:text="This app needs permission to gain access to system information, in order to track usage."
        android:textAlignment="center"
        android:textSize="24sp"
        android:textColor="#F59E0B"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appPurpose"
        android:layout_margin="15dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:id="@+id/okay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="100dp"
            android:text="Okay"
            android:textColor="#F59E0B"
            android:textSize="30sp"/>

        <TextView
            android:id="@+id/cancel_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginLeft="100dp"
            android:layout_toRightOf="@+id/okay_text"
            android:text="Cancel"
            android:textColor="#96F59E0B"
            android:textSize="30sp" />

    </RelativeLayout>
</RelativeLayout>